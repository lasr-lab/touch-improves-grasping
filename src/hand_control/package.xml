<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hand_control</name>
  <version>0.1.0</version>
  <description>Hand Controller that links a hand request to the hardware and adds visualization.</description>
  <maintainer email="nleukroth@lasr.org">Niklas Leukroth</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>lasr_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
